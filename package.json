{
  "name": "huahua-dsh-memory-os",
  "version": "1.2.0",
  "description": "huahua-dsh-memory-os：一站式 AgentOS（DeepSeek Harness）——分层记忆/自我进化/技能/待办/COI 调度/AIMS 身份角色记忆管理/人事部专家调度深度融合；让 Agent 数据裂变生长。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "!lib/**/*.bak",
    "!lib/**/*.corrupt-*",
    "agents/**",
    "!agents/.ops/**",
    "skills/**",
    "scripts/**",
    "vendor/**",
    "README.md",
    "README.en.md",
    "README-详细说明.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.2"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azure5100/huahua-dsh-memory-os.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "todo",
    "skills",
    "hos"
  ]
}
